{
  "name": "FZA Leitor PGN",
  "short_name": "FZA Leitor",
  "description": "Leitor gratuito de livros de xadrez em PGN, com tabuleiro e Stockfish.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#FBFAF6",
  "theme_color": "#2F5249",
  "icons": [
    { "src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "files": [
        { "name": "pgn", "accept": [".pgn", "application/x-chess-pgn", "application/vnd.chess-pgn", "text/plain", "application/octet-stream"] }
      ]
    }
  }
}
